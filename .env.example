# ChordProof — variáveis de ambiente
#
# Produção: https://chordproof.com  (Vercel: projeto `chordproof`)
# Todas estas variáveis estão configuradas no painel do Vercel (Production + Preview).

# ---------- Domínio ----------
# URL canônica do site. Usada em: canonical, og:url, sitemap.xml, robots.txt.
# Sem ela, o código cai no fallback https://chordproof.com (src/lib/seo.ts).
NEXT_PUBLIC_SITE_URL=https://chordproof.com

# URL base do NextAuth. Sem ela os callbackUrl das OAuth (Google/GitHub)
# apontam para http://localhost:3000 e o login quebra em produção.
NEXTAUTH_URL=https://chordproof.com
NEXTAUTH_SECRET=<gerado com: openssl rand -base64 32>

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://gyplitffeeexnsibxfrs.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<chave anon do projeto>

# ---------- OAuth ----------
# Redirect URI a cadastrar nos consoles Google/GitHub:
#   https://chordproof.com/api/auth/callback/google
#   https://chordproof.com/api/auth/callback/github
GOOGLE_CLIENT_ID=<google cloud console>
GOOGLE_CLIENT_SECRET=<google cloud console>
GITHUB_CLIENT_ID=<github oauth app>
GITHUB_CLIENT_SECRET=<github oauth app>

# ---------- Stripe ----------
STRIPE_SECRET_KEY=<sk_live_...>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<pk_live_...>
STRIPE_PRICE_MONTHLY=price_1UQXydK2RR9JD39GJdR7kBu0
STRIPE_PRICE_ANNUAL=price_1UQXydK2RR9JD39GF0pSS38e
# Endpoint do webhook no dashboard do Stripe (assinatura OBRIGATÓRIA — o
# endpoint recusa eventos sem stripe-signature):
#   https://chordproof.com/api/stripe/webhook
#   eventos: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_...
